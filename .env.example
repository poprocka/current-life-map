# ── Server only (never prefix with NEXT_PUBLIC_) ────────────────────────────
# Postgres connection for server routes (Supabase → Project Settings → Database → Connection pooling, "Transaction" URI)
DATABASE_URL=
# 32 random bytes, base64:  openssl rand -base64 32   — encrypts free-text answers and coach notes
FIELD_ENCRYPTION_KEY=
# Random secret for signed one-time booking link tokens:  openssl rand -base64 32
BOOKING_TOKEN_SECRET=
# Calendly: event type booking page URL and the webhook signing key you chose when creating the webhook subscription
CALENDLY_SCHEDULING_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=
# "false" only if the Deep Dive is not paid through Calendly
CALENDLY_PAYMENT_REQUIRED=true
# Stripe → Developers → Webhooks → signing secret (refunds, failures, disputes)
STRIPE_WEBHOOK_SECRET=
# Resend: API key, verified sender, and webhook signing secret (delivery / bounce events)
RESEND_API_KEY=
EMAIL_FROM="Jana | The Self-Interview <talk@self-interview.com>"
# Optional: where replies go (defaults to EMAIL_FROM)
EMAIL_REPLY_TO=talk@self-interview.com
RESEND_WEBHOOK_SECRET=
# Vercel Cron bearer secret for /api/cron/retry
CRON_SECRET=

# ── Public (safe in the browser by design) ──────────────────────────────────
# Supabase project URL + anon key: used only for coach sign-in; every read is authorised server-side and by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 once Calendly + webhooks are configured and tested
NEXT_PUBLIC_BOOKING_ENABLED=

# Optional: path to a Chromium executable for PDF rendering on non-serverless hosts (Vercel uses @sparticuz/chromium)
PDF_CHROMIUM_PATH=

# Public address of the site (client links, booking link in the PDF email), e.g. https://self-interview.com
NEXT_PUBLIC_SITE_URL=
# Coach portal host, e.g. coach.self-interview.com: the portal answers only there, and the public site never serves /admin
COACH_HOST=

# Google Analytics 4 (optional). Loaded only after a visitor opts in; never on /admin or /book; no answers ever sent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# 1 = turn on Google signals (age range, gender, interests in GA reports); the consent banner then says so.
NEXT_PUBLIC_GA_SIGNALS=
